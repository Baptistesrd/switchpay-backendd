# ── Routing ────────────────────────────────────────────────────────────────────
# Strategy used by the smart router to select a PSP per transaction.
# Options: "weighted_score" (default) | "thompson"
PSP_SELECTION_STRATEGY=weighted_score

# ── API Keys ───────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys in the format key:OrgName
# Example: sk_live_abc123:Acme,sk_live_xyz789:Beta Corp
API_KEYS=your-api-key-here:YourOrgName

# ── SMTP / Email ───────────────────────────────────────────────────────────────
# Used by the contact form and waitlist signup to send notification emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_TO=recipient@yourdomain.com

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to project root).
# For production, use a persistent volume mount.
# DATABASE_URL=sqlite:///./transactions.db

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Secret key for Stripe PaymentIntents integration.
# Test mode  (no real charges): sk_test_...  — get it from dashboard.stripe.com/test/apikeys
# Live mode  (real charges):    sk_live_...  — use only in production, never commit this value.
# Leave empty to disable real Stripe calls (will raise RuntimeError at startup).
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — used to verify Stripe event signatures on /webhook/stripe.
# Get it from dashboard.stripe.com/test/webhooks after creating an endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Debug ──────────────────────────────────────────────────────────────────────
DEBUG=false
